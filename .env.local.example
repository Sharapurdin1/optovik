# --- База данных PostgreSQL (обязательно) ---
# Локально через Postgres.app (https://postgresapp.com):
#   1) запустите Postgres.app → Initialize;
#   2) создайте базу: /Applications/Postgres.app/Contents/Versions/latest/bin/createdb optovik
#   3) пропишите адрес ниже (пользователь — имя пользователя macOS, без пароля).
# Или через Docker: docker compose up -d → postgres://optovik:optovik@localhost:5432/optovik
# На сервере — адрес Managed PostgreSQL из панели Timeweb.
# Таблицы создаются сами при запуске (миграции из папки drizzle/).
DATABASE_URL=postgres://ИМЯ_ПОЛЬЗОВАТЕЛЯ@localhost:5432/optovik

# --- Адрес сайта (обязательно на проде) ---
# Нужен для ссылок в Telegram, например https://optovik.ru
APP_URL=http://localhost:3000

# --- Приём заказов в Telegram ---
#
# СКОПИРУЙТЕ этот файл в .env.local и впишите свои значения.
# Файл .env.local в git не попадёт (он в .gitignore) — ключ останется секретным.
#
# Как получить значения:
#   1) В Telegram напишите @BotFather → /newbot → придумайте имя.
#      Он выдаст токен вида 123456789:AA... — это TELEGRAM_BOT_TOKEN.
#   2) Напишите вашему новому боту любое сообщение (например «привет»).
#   3) Узнайте TELEGRAM_CHAT_ID: напишите боту @userinfobot — он пришлёт ваш id.
#      (или создайте группу, добавьте туда бота и @userinfobot).
#
# После изменения .env.local перезапустите приложение (npm run dev).

TELEGRAM_BOT_TOKEN=сюда_вставьте_токен_от_BotFather
TELEGRAM_CHAT_ID=сюда_вставьте_ваш_chat_id

# --- Каталог товаров из Google-таблицы (необязательно) ---
# Если не задано — магазин работает на встроенном списке товаров.
#
# Как получить ссылку:
#   1) Создайте Google-таблицу и загрузите в неё catalog-template.csv
#      (Файл → Импорт → Загрузить → Заменить текущий лист).
#   2) Файл → Поделиться → Опубликовать в интернете →
#      выберите лист и формат «CSV» → Опубликовать.
#   3) Скопируйте выданную ссылку сюда.
SHEET_CSV_URL=

# --- Отправка СМС-кодов при входе (необязательно) ---
# Если не задано — вход работает в демо-режиме: код показывается на экране.
# Как получить: зарегистрируйтесь на smsaero.ru, пополните баланс,
# зарегистрируйте «имя отправителя» (sign), возьмите email и API-ключ.
SMS_AERO_EMAIL=
SMS_AERO_API_KEY=
SMS_AERO_SIGN=

# --- Пароль владельца для панели /manage ---
ADMIN_PASSWORD=

# --- Номера владельцев (вход по телефону = доступ к /manage) ---
OWNER_PHONES=

# --- Секрет для подписи сессий входа (на проде обязательно, от 32 символов) ---
# Сгенерировать: openssl rand -base64 48
SESSION_SECRET=
