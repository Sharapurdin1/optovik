# Caddy — входная дверь сайта: HTTPS (сертификат Let's Encrypt получает и
# продлевает сам), сжатие, заголовки безопасности.
# Домены задаются в /opt/optovik/.env на сервере:
#   DOMAIN=optdostavka05.ru                      — основной адрес сайта
#   REDIRECT_HOSTS="www.optdostavka05.ru ..."    — адреса, которые ведут на основной

{$DOMAIN} {
	encode zstd gzip

	request_body {
		max_size 10MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Журнал посещений: время, страница, IP, браузер. На сервере —
	# /opt/optovik/logs/access.log. Старые куски сжимаются и через 30 дней
	# удаляются. Cookie и пароли Caddy сам пишет как REDACTED.
	log {
		output file /var/log/caddy/access.log {
			mode 644
			roll_size 20MiB
			roll_keep 10
			roll_keep_for 720h
		}
	}

	# Не засоряем журнал: скрипты и картинки сайта, проверки доступности.
	@nolog path /_next/static/* /_next/image /favicon.ico /api/health
	log_skip @nolog

	reverse_proxy app:3000
}

# Остальные адреса (www, другие домены) → основной домен
{$REDIRECT_HOSTS} {
	redir https://{$DOMAIN}{uri} permanent
}
