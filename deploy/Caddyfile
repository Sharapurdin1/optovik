# Caddy — входная дверь сайта: HTTPS (сертификат Let's Encrypt получает
# сам, когда SITE_ADDRESS — это домен), сжатие, заголовки безопасности.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	request_body {
		max_size 10MB
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	reverse_proxy app:3000
}
